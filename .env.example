# gian-new origin, without /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web client id from Google Cloud. Must be listed in gian-new's AUTH_GOOGLE_CLIENT_IDS,
# and this site's origin must be an Authorized JavaScript origin on that client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Hotel dashboard (dashboard-new) origin, e.g. http://localhost:5173. "Open account" on a client
# sends staff to <this>/staff-access. Empty: the button stays off.
NEXT_PUBLIC_HOTEL_DASHBOARD_URL=
