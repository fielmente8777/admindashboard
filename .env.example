# gian-new origin, without /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web client id from Google Cloud. Must be listed in gian-new's AUTH_GOOGLE_CLIENT_IDS,
# and this site's origin must be an Authorized JavaScript origin on that client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Keep in step with gian-new's AUTH_STAFF_EMAIL_DOMAINS
NEXT_PUBLIC_STAFF_EMAIL_DOMAINS=eazotel.com,fielmente.com
